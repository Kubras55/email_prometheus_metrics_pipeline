# =====================================================================
# E-Mail Excel/CSV ETL Pipeline - Prometheus Metrics (.prom) Configuration
# =====================================================================

# Email / IMAP Connection Settings
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASSWORD=your_app_password_here
IMAP_FOLDER=INBOX
IMAP_SCAN_LIMIT=0
IMAP_GMAIL_ATTACHMENT_QUERY={filename:xlsx filename:xls filename:csv}
EMAIL_SUBJECT_FILTER=şikayet oranı dağılımı
EMAIL_SUBJECT_MATCH_MODE=exact
EMAIL_SENDER_FILTER=
ENABLE_LOCAL_DOWNLOAD_FALLBACK=false

# Prometheus Exporter Settings (.prom output for Grafana)
PROMETHEUS_METRICS_PATH=./metrics/email_metrics.prom
METRICS_STATE_PATH=./metrics/cumulative_metrics.json
METRICS_HTTP_HOST=127.0.0.1
METRICS_HTTP_PORT=9464

# Engine & Polling Settings
POLL_INTERVAL_SECONDS=60
CHUNK_SIZE=50000
POLARS_MAX_THREADS=4
DOWNLOAD_DIR=./downloads
STATE_FILE_PATH=./downloads/processed_state.json
